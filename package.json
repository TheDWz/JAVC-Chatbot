{
  "name": "javc-chatbot",
  "version": "1.0.2",
  "description": "JAVC Chatbot: a desktop client for OpenAI-compatible APIs",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test.js",
    "lint": "eslint .",
    "typecheck": "tsc -p .",
    "dist:linux": "electron-builder --linux",
    "dist:win": "npm install --no-save --force @napi-rs/canvas-win32-x64-msvc@$(node -p \"require('@napi-rs/canvas/package.json').version\") && electron-builder --win",
    "dist": "npm run dist:linux && npm run dist:win",
    "build:mobile": "node mobile/build.mjs",
    "android:sync": "npm run build:mobile && cap sync android",
    "dist:android": "npm run android:sync && node mobile/gradle.mjs assembleRelease",
    "dist:android:debug": "npm run android:sync && node mobile/gradle.mjs assembleDebug",
    "ios:sync": "npm run build:mobile && cap sync ios",
    "dist:ios": "npm run ios:sync && node mobile/ipa.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "marked": "^18.1.2",
    "pdf-parse": "^2.4.5"
  },
  "author": {
    "name": "TheDWz",
    "email": "javc-chatbot@localhost"
  },
  "build": {
    "appId": "io.github.thedwz.javc-chatbot",
    "productName": "JAVC Chatbot",
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "category": "Utility",
      "executableName": "javc-chatbot",
      "synopsis": "Chat with any OpenAI-compatible API",
      "description": "JAVC Chatbot is a desktop client for OpenAI-compatible APIs with connection profiles, personas, streaming replies and a live reasoning view.",
      "files": [
        "main.js",
        "preload.js",
        "api.js",
        "chats.js",
        "seal.js",
        "backup.js",
        "profiles.js",
        "store.js",
        "disk.js",
        "lib.js",
        "mcp.js",
        "renderer.js",
        "index.html",
        "build/icon.png",
        "!node_modules/@napi-rs/canvas-win32-*/**"
      ],
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "files": [
        "main.js",
        "preload.js",
        "api.js",
        "chats.js",
        "seal.js",
        "backup.js",
        "profiles.js",
        "store.js",
        "disk.js",
        "lib.js",
        "mcp.js",
        "renderer.js",
        "index.html",
        "build/icon.png",
        "!node_modules/@napi-rs/canvas-linux-*/**"
      ]
    },
    "appImage": {
      "artifactName": "JAVC-Chatbot-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "JAVC-Chatbot-Setup-${version}.${ext}"
    }
  },
  "homepage": "https://github.com/TheDWz/JAVC-Chatbot",
  "desktopName": "javc-chatbot.desktop",
  "license": "GPL-3.0-or-later"
}
