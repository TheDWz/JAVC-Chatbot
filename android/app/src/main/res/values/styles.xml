<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The window background shows behind the status and navigation bars and while the app starts,
         so it uses the page's own background colour (light or dark, following the system). -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/app_bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/app_bg</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/app_bg</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBar" />
</resources>
