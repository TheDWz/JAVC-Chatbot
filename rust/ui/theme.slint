export component Icon inherits Path {
    in property <string> d;
    in property <color> color: Theme.text;
    commands: d;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 18px;
    height: 18px;
    fill: transparent;
    stroke: color;
    stroke-width: 2px;
    stroke-line-cap: round;
}
