// Colors: one token set for light and dark (the system setting decides). Accents come from the chosen theme.
import { Palette } from "std-widgets.slint";

export global Theme {
    in-out property <color> a1: #8b5cf6;
    in-out property <color> a2: #3b82f6;
    out property <bool> dark: Palette.color-scheme != ColorScheme.light;
    out property <brush> grad: @linear-gradient(135deg, a1 0%, a2 100%);
    out property <color> bg: dark ? #0f1014 : #f6f6f9;
    out property <color> surface: dark ? #17181e : #ffffff;
    out property <color> surface-2: dark ? #1f2129 : #f0f0f5;
    out property <color> line: dark ? #2a2c36 : #e2e3ea;
    out property <color> line-soft: dark ? #22242c : #ececf2;
    out property <color> text: dark ? #ecedf2 : #1a1b22;
    out property <color> muted: dark ? #8d91a0 : #666a78;
    out property <color> faint: dark ? #5d6170 : #9a9daa;
    out property <color> err: dark ? #f87171 : #dc2626;
    out property <color> code-bg: dark ? #0b0c10 : #f3f3f7;
    // accent for text and links, pulled toward the text color so any theme stays readable
    out property <color> accent-text: dark ? a1.mix(#ecedf2, 0.65) : a1.mix(#1a1b22, 0.65);
    out property <color> tint: a1.with-alpha(0.12);
    out property <color> ring: a1.with-alpha(0.5);
}

